[Unit]
Description=GTA VI Telegram editorial bot
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=trygta
EnvironmentFile=/etc/trygta.env
ExecCondition=/usr/bin/python3 -c "import os,sys; sys.exit(0 if all(os.getenv(k) for k in ('BOT_TOKEN','APIFY_API_TOKENS','RIVER_API_KEY')) and os.getenv('OWNER_ID','').isdigit() else 1)"
ExecStart=/usr/bin/python3 /opt/trygta/bot.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
